rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        (request.auth.uid == userId ||
         (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['vendorStatus', 'accountStatus', 'updatedAt'])));
    }

    match /wallets/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      // Balance is not client-writable — only a trusted process (Cloud Function)
      // may change it once money-movement features land.
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.balance == resource.data.balance;
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid ||
         isAdmin());
      // All money-moving transactions are written by the transferMoney Cloud
      // Function (Admin SDK, bypasses rules) so every transfer gets the same
      // server-side balance/eligibility validation. No client writes.
      allow create, update, delete: if false;
    }

    match /paymentRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.vendorUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Vendor may cancel their own pending request.
      allow update: if request.auth != null &&
        resource.data.vendorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'cancelled';
      // Any other authenticated user may claim a pending request as the payer.
      allow update: if request.auth != null &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'paid' &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'studentUid', 'studentName', 'paidAt', 'transactionId']);
      allow delete: if false;
    }
  }
}
