rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      // vendorStatus is intentionally not in this list — vendor approval/
      // rejection goes exclusively through the approveVendor Cloud Function
      // (Admin SDK, bypasses rules) so it gets the isAdmin + role/status
      // checks server-side. Admin's direct client writes stay limited to
      // suspend/reactivate (accountStatus).
      allow update: if request.auth != null &&
        (request.auth.uid == userId ||
         (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['accountStatus', 'updatedAt'])));
    }

    match /wallets/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      // All balance fields are server-granted, not client-writable — only a
      // trusted process (Cloud Function, admin tooling) may change them.
      // The owner may still update other wallet fields (e.g. a future
      // preferences field) as long as none of these move. balance and points
      // have existed on every wallet doc since account creation, so plain dot
      // notation is safe; flexBalance/bonusBalance/mealSwipes use
      // get(key, null) instead because wallets created before those fields
      // existed don't have them, and dot-accessing a missing map key errors
      // out the whole rule.
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.balance == resource.data.balance &&
        request.resource.data.points == resource.data.points &&
        request.resource.data.get('flexBalance', null) == resource.data.get('flexBalance', null) &&
        request.resource.data.get('bonusBalance', null) == resource.data.get('bonusBalance', null) &&
        request.resource.data.get('mealSwipes', null) == resource.data.get('mealSwipes', null);
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      // Firestore validates a list query against this rule using only the
      // fields the query itself filters on — it can't infer that
      // `participants` is always [fromUid, toUid] just because that's true
      // of every doc this app happens to write. Screens that query
      // `where('participants', arrayContains: uid)` (Transaction History,
      // dashboards) need the participants clause below to match; screens
      // that query `fromUid ==` / `toUid ==` directly need those clauses.
      // Drop any one of the three and its matching query starts silently
      // failing with permission-denied even though the data is correct.
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid ||
         request.auth.uid in resource.data.participants ||
         isAdmin());
      // All money-moving transactions are written by the transferMoney Cloud
      // Function (Admin SDK, bypasses rules) so every transfer gets the same
      // server-side balance/eligibility validation. No client writes.
      allow create, update, delete: if false;
    }

    match /paymentRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.vendorUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Vendor may cancel their own pending request.
      allow update: if request.auth != null &&
        resource.data.vendorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'cancelled';
      // Any other authenticated user may claim a pending request as the payer.
      allow update: if request.auth != null &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'paid' &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'studentUid', 'studentName', 'paidAt', 'transactionId']);
      allow delete: if false;
    }

    match /studentIdTokens/{token} {
      // Minted exclusively by issueStudentIdToken (Admin SDK) so a client
      // can't forge a token claiming to be a different uid. Readable by any
      // authenticated user so a future verifier (vendor/admin scan) can
      // look one up.
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /offers/{offerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.vendorUid == request.auth.uid;
      // Vendor manages their own offer (edit/toggle). Redemption (which
      // bumps usedCount) goes exclusively through redeemOffer (Admin SDK,
      // bypasses rules) so a client can't inflate the count by calling
      // update() in a loop with no per-user record.
      allow update: if request.auth != null && resource.data.vendorUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.vendorUid == request.auth.uid;

      match /redemptions/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /supportChats/{chatId} {
      // Written exclusively by sendSupportMessage/claimSupportChat/
      // sendAdminReply/closeSupportChat (Admin SDK, bypasses rules) so the
      // AI escalation logic and admin assignment can't be spoofed from the
      // client. Owner and admins may read.
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;

      match /messages/{messageId} {
        // Same reasoning as the parent doc — every message (user, assistant,
        // admin, or system) is written by a Cloud Function so a client can't
        // forge an assistant/admin reply or read another user's chat.
        allow read: if request.auth != null &&
          (get(/databases/$(database)/documents/supportChats/$(chatId)).data.userId == request.auth.uid || isAdmin());
        allow create, update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      // Written exclusively by Cloud Functions alongside the event that
      // triggered them (a transfer, a deposit, a vendor decision). Owner can
      // only flip `read` — nothing else about their own notifications.
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
  }
}
